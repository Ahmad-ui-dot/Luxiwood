{
  "name": "@luxiwood/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "test": "jest --runInBand",
    "lint": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "openapi:export": "nest build && node dist/openapi-export",
    "check:swagger": "tsx scripts/check-swagger.ts"
  },
  "dependencies": {
    "@luxiwood/shared": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.6.1",
    "multer": "2.4.0",
    "nodemailer": "^7.0.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^7.0.12",
    "@types/supertest": "^7.2.1",
    "jest": "29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testRegex": ".e2e-spec.ts$",
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ],
    "testTimeout": 30000
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
