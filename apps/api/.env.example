# Подключение к PostgreSQL (совпадает с docker-compose.yml в корне)
DATABASE_URL="postgresql://luxiwood:luxiwood@localhost:5440/luxiwood?schema=public"

# Секрет для подписи JWT — замените на длинную случайную строку
JWT_SECRET="change-me-to-a-long-random-string"

# Администратор, который создаётся при seed
ADMIN_EMAIL="admin@luxiwood.tj"
ADMIN_PASSWORD="change-me"

PORT=4000

# Адрес фронтенда (Next.js), которому разрешены запросы
CORS_ORIGIN="http://localhost:3000"

# Почта для восстановления пароля (Gmail).
# SMTP_PASS — не обычный пароль, а «пароль приложения» из 16 букв:
# Google-аккаунт → Безопасность → Двухэтапная аутентификация (включить) → Пароли приложений → создать.
# Если не заполнено, при разработке письмо не отправляется, а код печатается в консоль API
SMTP_USER=""
SMTP_PASS=""
# От кого письмо. Пусто — «Luxiwood <SMTP_USER>»
MAIL_FROM=""

# Swagger (/api/docs и /api/docs-json). При разработке включён всегда.
# В production (NODE_ENV=production) выключен, пока здесь не стоит true
SWAGGER_ENABLED=false
